%%{init: {"flowchart": {"useMaxWidth": false, "htmlLabels": true}}}%%
graph TD
    %% =====================================
    %% 1. הגדרת כל הצמתים (כדי לבודד את העברית)
    %% =====================================
    Start(("יצירת הזדמנויות היכרות - מודל מוטי"))
    Channels{"בחירת ערוץ"}
    
    Natural["סביבה טבעית / מעגלים חמים"]
    NatExamples["שבתות עם חברים / אירועי תוכן / התנדבות"]
    Strategy["אסטרטגיה: יצירת ערב חברתי לא מכני"]
    
    Cold["ברים / פנייה קרה"]
    Barrier{"למה אני מפחד לפנות?"}
    FearLooks["היא נראית ממש טוב וזה מפחיד אותי"]
    FomoBar["תחושת השוואה קשה / פומו"]
    NotReady["פחד שאני לא מוכן עדיין ואם אפנה עכשיו אהרוס..."]
    
    B11["פחד שהיא תזלזל בי, כי אני חסר ביטחון"]
    B12["פחד שהיא תצחק עליי, כי אני אתחיל מגוחך"]
    B13["פחד שהיא תתעלם ממני ותיתן לי הרגשה שאני לא קיים"]
    B14["פחד שהיא תרחם עליי"]
    B131["פחד שאחרים יראו את זה ויאמצו את הגישה"]
    
    NR1["פחד שאני לא נראה מספיק טוב כי לא התלבשתי יפה"]
    NR2["פחד שאני לא אדע מה להגיד ואגמגם ואסמיק"]
    NR3["פחד שאני לא אדע איך לסיים את הסיטואציה יפה וזה יהיה מביך"]
    
    B21["סיפורים שאני רואה במציאות: ליטופים, נשיקות, צחוקים"]
    B22["סיפורים שאני מדמיין בראש: מה הם עושים בבית"]
    
    Apps["אפליקציות דייטינג"]
    AppEffort["ניסיון ממושך: כמה חודשים בכמה אפליקציות"]
    AppsStatus{"סטטוס: תקוע / שחיקה"}
    Fomo["השוואה / פומו"]
    Texts["טקסטים"]
    Img["תמונות"]
    ImgDetail["הרגשה שאין לי תמונות מספיק טובות"]
    TextsDetail["הרגשה שאין לי טקסטים מספיק טובים"]
    FomoDetail["הרגשה שכולם מוצאים דייטים ורק אני לא"]
    Exhaustion["תחושת תשישות נפשית"]
    
    Step1["שלב א: אינטראקציה ראשונית"]
    Step1Goal{"ייצור מענה חזרה"}
    Step2["שלב ב: מעבר לוואטסאפ"]
    Step2Strategy["התכתבות של כמה ימים / ביסוס קשר"]
    Step3["שלב ג: דייטים"]
    Step3Field["למידה של השטח הלא מוכר"]

    %% =====================================
    %% 2. מבני ערוצים וסידור אופקי (ימין לשמאל)
    %% =====================================
    Start --> Channels
    
    subgraph ChannelA [" "]
        direction TD
        Apps --> AppEffort
        AppEffort --> AppsStatus
        AppsStatus --> Fomo
        AppsStatus --> Texts
        AppsStatus --> Img
        Img --> ImgDetail
        Texts --> TextsDetail
        Fomo --> FomoDetail
        AppsStatus --> Exhaustion
    end

    subgraph ChannelB [" "]
        direction TD
        Cold --> Barrier
        Barrier --> FearLooks
        Barrier --> FomoBar
        Barrier --> NotReady
        FearLooks --> B11
        FearLooks --> B12
        FearLooks --> B13
        FearLooks --> B14
        B13 --> B131
        NotReady --> NR1
        NotReady --> NR2
        NotReady --> NR3
        FomoBar --> B21
        FomoBar --> B22
    end

    subgraph ChannelC [" "]
        direction TD
        Natural --> NatExamples
        NatExamples --> Strategy
        
        %% אסטרטגיה
        Strategy --> Step1
        Step1 -->|"פינג פונג"| Step1Goal
        Step1Goal -->|"הצלחה"| Step2
        Step2 --> Step2Strategy
        Step2Strategy -->|"הצלחה"| Step3
        Step3 --> Step3Field
    end

    %% חיבור הערוצים מבלוק הבחירה
    Channels -->|"ערוץ א"| Apps
    Channels -->|"ערוץ ב"| Cold
    Channels -->|"ערוץ ג - מועדף"| Natural

    %% קישורים שקופים רק בין הסאבגרפים עצמם כדי להכריח את הסדר (א' בימין, ג' בשמאל)
    ChannelA ~~~ ChannelB
    ChannelB ~~~ ChannelC

    %% =====================================
    %% 3. עיצוב וסטיילינג (CSS)
    %% =====================================
    %% הוספת מרווחים, שבירת פינות וצבעים רכים ונעימים ליצירת מראה פרמיום
    
    classDef default fill:#ffffff,stroke:#cbd5e1,stroke-width:2px,color:#1e293b,rx:8px,ry:8px;
    classDef highlighted fill:#fdf4ff,stroke:#d946ef,stroke-width:2px,color:#86198f,rx:8px,ry:8px;
    classDef primaryAction fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#1d4ed8,rx:8px,ry:8px;
    classDef painPoint fill:#fef2f2,stroke:#ef4444,stroke-width:2px,color:#b91c1c,rx:8px,ry:8px;
    classDef mainNode fill:#f8fafc,stroke:#94a3b8,stroke-width:3px,color:#0f172a,rx:12px,ry:12px;
    classDef invisible background:none,fill:none,stroke:none,color:transparent;

    class Start mainNode;
    class Natural highlighted;
    class Step1,Step2,Step3 primaryAction;
    class Barrier,AppsStatus,FearLooks,NotReady,FomoBar painPoint;
    class ChannelA,ChannelB,ChannelC invisible;

    %% הכרחת מרחק רוחבי נוסף למבנה
    linkStyle 0,1 stroke-width:0px;